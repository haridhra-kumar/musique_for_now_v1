# AudioCoach AI — Backend Configuration
# Copy to .env and fill in values

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/audiocoach
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=your-secret-key-change-in-production
DEBUG=true

# File storage: "local" for dev, "s3" for Cloudflare R2
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Cloudflare R2 / S3 (only needed if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=audiocoach-uploads

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
