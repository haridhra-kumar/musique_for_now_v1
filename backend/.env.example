# ==============================================================================
# AudioCoach AI - Backend Environment Variables
# ==============================================================================

# Application
APP_NAME="AudioCoach AI"
DEBUG=False

# Database (PostgreSQL)
# For local dev without Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/audiocoach
# For Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/audiocoach
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/audiocoach

# Redis
# For local dev: redis://localhost:6379/0
# For Docker Compose: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# Celery Task Queue
# For local dev: redis://localhost:6379/1 and /2
# For Docker Compose: redis://redis:6379/1 and /2
# For Upstash Redis on Render: rediss://default:token@host.upstash.io:6379 (uses DB 0 with TLS)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT Authentication
JWT_SECRET=replace-this-with-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Backend ("local" or "s3")
# On Render production, set STORAGE_BACKEND=s3 so the Web API and Celery Worker share storage
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=200

# S3 / Cloudflare R2 Settings (required when STORAGE_BACKEND=s3)
# For Cloudflare R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: leave S3_ENDPOINT_URL empty and set S3_REGION to e.g. us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=audiocoach-uploads
S3_REGION=auto

# User Credits & Limits
FREE_ANALYSES_PER_DAY=1
SIGNUP_BONUS_CREDITS=5

# CORS Allowed Origins (comma-separated, or Vercel URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://*.vercel.app
